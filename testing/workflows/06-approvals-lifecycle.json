{
  "name": "SendIt Test 06 - Approvals Lifecycle",
  "nodes": [
    {
      "parameters": {},
      "id": "manual_trigger",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://sendit.infiniteappsai.com/api/v1/approvals",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{'Bearer ' + $env.SENDIT_API_KEY}}" }
          ]
        },
        "options": {}
      },
      "id": "approvals_list",
      "name": "GET /approvals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nif (payload.success === false) throw new Error(payload.error || 'Approvals list failed');\nconst posts = Array.isArray(payload.posts) ? payload.posts : Array.isArray(payload.data?.posts) ? payload.data.posts : [];\nconst firstId = posts[0]?.id || '';\nreturn [{ json: { pendingCount: posts.length, approvalPostId: firstId, canMutate: false } }];"
      },
      "id": "normalize_approvals",
      "name": "Normalize Approvals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{ $json.canMutate && !!$json.approvalPostId }}", "value2": true }
          ]
        }
      },
      "id": "if_mutate",
      "name": "IF Run Approve/Reject?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [780, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://sendit.infiniteappsai.com/api/v1/approvals/{{ $json.approvalPostId }}/approve",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{'Bearer ' + $env.SENDIT_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"comment\":\"Automated approval check\"}",
        "options": {}
      },
      "id": "approvals_approve",
      "name": "POST /approvals/:id/approve",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, -120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://sendit.infiniteappsai.com/api/v1/approvals/{{ $node['Normalize Approvals'].json.approvalPostId }}/reject",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{'Bearer ' + $env.SENDIT_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"reason\":\"Automated rejection check\"}",
        "options": {}
      },
      "id": "approvals_reject",
      "name": "POST /approvals/:id/reject",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 120]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { passed: true, scenario: 'approvals_list_only', note: 'Set canMutate=true in Normalize Approvals to execute approve/reject paths.' } }];"
      },
      "id": "safe_complete",
      "name": "Safe Complete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 0]
    }
  ],
  "connections": {
    "Start": { "main": [[{ "node": "GET /approvals", "type": "main", "index": 0 }]] },
    "GET /approvals": { "main": [[{ "node": "Normalize Approvals", "type": "main", "index": 0 }]] },
    "Normalize Approvals": {
      "main": [[{ "node": "IF Run Approve/Reject?", "type": "main", "index": 0 }]]
    },
    "IF Run Approve/Reject?": {
      "main": [
        [{ "node": "POST /approvals/:id/approve", "type": "main", "index": 0 }],
        [{ "node": "Safe Complete", "type": "main", "index": 0 }]
      ]
    },
    "POST /approvals/:id/approve": {
      "main": [[{ "node": "POST /approvals/:id/reject", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
