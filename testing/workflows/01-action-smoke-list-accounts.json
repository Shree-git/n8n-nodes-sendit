{
  "name": "SendIt Test 01 - Action Smoke (List Accounts)",
  "nodes": [
    {
      "parameters": {},
      "id": "manual_trigger",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://sendit.infiniteappsai.com/api/v1/accounts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SENDIT_API_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "sendit_list_accounts",
      "name": "GET /accounts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nif (payload.success === false) {\n  throw new Error(payload.error || 'List accounts request failed');\n}\nconst accounts = Array.isArray(payload.accounts)\n  ? payload.accounts\n  : Array.isArray(payload.data)\n    ? payload.data\n    : [];\nreturn [{\n  json: {\n    scenario: 'action_smoke_list_accounts',\n    passed: true,\n    accountCount: accounts.length,\n    accountIds: accounts.map((a) => a?.id).filter(Boolean),\n    rawKeys: Object.keys(payload),\n  },\n}];"
      },
      "id": "assert_accounts_payload",
      "name": "Assert Accounts Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0]
    }
  ],
  "connections": {
    "Start": {
      "main": [[{ "node": "GET /accounts", "type": "main", "index": 0 }]]
    },
    "GET /accounts": {
      "main": [[{ "node": "Assert Accounts Payload", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
