    },
    {
      "parameters": {
        "jsCode": "const resp = $input.all()[0].json;\n// AI generation can be slow and may timeout\nif (resp.statusCode === 504 || resp.statusCode === 502) {\n  return [{ json: { test: 'ai_generate_content', passed: true, skipped: true, reason: 'AI generation timeout' } }];\n}\nif (resp.statusCode !== 200) throw new Error(`Expected 200, got ${resp.statusCode}`);\nconst body = resp.body || resp;\nif (body.success !== true) throw new Error('Expected success: true');\nif (!body.platformVariants) throw new Error('Expected platformVariants');\nreturn [{ json: { test: 'ai_generate_content', passed: true } }];"
      },
