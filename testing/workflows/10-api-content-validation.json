    {
      "parameters": {
        "jsCode": "const body = $input.all()[0].json;\nif (body.success !== true) throw new Error('Expected success: true');\nif (typeof body.valid !== 'boolean') throw new Error('Expected valid field to be boolean');\nif (!Array.isArray(body.errors)) throw new Error('Expected errors array');\nif (!body.platformLimits) throw new Error('Expected platformLimits object');\nreturn [{ json: { test: 'validate_valid_content', passed: true } }];"
      },
