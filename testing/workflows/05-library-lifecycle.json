{
  "name": "SendIt Test 05 - Library Lifecycle",
  "nodes": [
    {
      "parameters": {},
      "id": "manual_trigger",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const runId = Date.now();\nreturn [{\n  json: {\n    runId,\n    title: `n8n-lib-${runId}`,\n    text: `Library test content ${runId}`,\n  },\n}];"
      },
      "id": "fixture",
      "name": "Build Library Fixture",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sendit.infiniteappsai.com/api/v1/library",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{'Bearer ' + $env.SENDIT_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.title, text: $json.text, type: 'template', category: 'automation', tags: ['n8n','sendit'], targetPlatforms: ['linkedin','x'], evergreen: { enabled: false } }) }}",
        "options": {}
      },
      "id": "library_create",
      "name": "POST /library",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nif (payload.success === false) throw new Error(payload.error || 'Library create failed');\nconst id = payload.item?.id || payload.id || payload.data?.item?.id || payload.data?.id;\nif (!id) throw new Error(`Missing library item id in payload: ${JSON.stringify(payload)}`);\nreturn [{ json: { itemId: id, passed: true, scenario: 'library_create' } }];"
      },
      "id": "assert_create",
      "name": "Assert Library Create",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 0]
    },
    {
      "parameters": {
        "url": "=https://sendit.infiniteappsai.com/api/v1/library/{{ $json.itemId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{'Bearer ' + $env.SENDIT_API_KEY}}" }
          ]
        },
        "options": {}
      },
      "id": "library_get",
      "name": "GET /library/:id",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 0]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://sendit.infiniteappsai.com/api/v1/library/{{ $node['Assert Library Create'].json.itemId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{'Bearer ' + $env.SENDIT_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: 'updated-' + $node['Build Library Fixture'].json.title, text: 'updated-' + $node['Build Library Fixture'].json.text, type: 'draft', category: 'automation', tags: ['n8n','sendit','updated'], targetPlatforms: ['threads'] }) }}",
        "options": {}
      },
      "id": "library_update",
      "name": "PATCH /library/:id",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 0]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=https://sendit.infiniteappsai.com/api/v1/library/{{ $node['Assert Library Create'].json.itemId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{'Bearer ' + $env.SENDIT_API_KEY}}" }
          ]
        },
        "options": {}
      },
      "id": "library_delete",
      "name": "DELETE /library/:id",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 0]
    }
  ],
  "connections": {
    "Start": { "main": [[{ "node": "Build Library Fixture", "type": "main", "index": 0 }]] },
    "Build Library Fixture": {
      "main": [[{ "node": "POST /library", "type": "main", "index": 0 }]]
    },
    "POST /library": {
      "main": [[{ "node": "Assert Library Create", "type": "main", "index": 0 }]]
    },
    "Assert Library Create": {
      "main": [[{ "node": "GET /library/:id", "type": "main", "index": 0 }]]
    },
    "GET /library/:id": {
      "main": [[{ "node": "PATCH /library/:id", "type": "main", "index": 0 }]]
    },
    "PATCH /library/:id": {
      "main": [[{ "node": "DELETE /library/:id", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
