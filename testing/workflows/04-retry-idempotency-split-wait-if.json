{
  "name": "SendIt Test 04 - Retry and Idempotency Pattern",
  "nodes": [
    {
      "parameters": {},
      "id": "manual_trigger",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const runId = Date.now();\nreturn [\n  { json: { dedupeKey: `retry-${runId}-1`, text: `Retry pattern post ${runId} #1`, platforms: ['threads'], alreadyProcessed: false, retryCount: 0 } },\n  { json: { dedupeKey: `retry-${runId}-1`, text: `Retry pattern post ${runId} #1 duplicate`, platforms: ['threads'], alreadyProcessed: true, retryCount: 0 } },\n  { json: { dedupeKey: `retry-${runId}-2`, text: `Retry pattern post ${runId} #2`, platforms: ['threads'], alreadyProcessed: false, retryCount: 0 } },\n];"
      },
      "id": "seed_items",
      "name": "Seed Batch Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split_batches",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.alreadyProcessed === true }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if_idempotency_gate",
      "name": "IF Already Processed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 0]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ...$json, scenario: 'retry_idempotency', outcome: 'skipped_duplicate', passed: true } }];"
      },
      "id": "skip_duplicate",
      "name": "Skip Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, -140]
    },
    {
      "parameters": {
        "resource": "post",
        "operation": "publish",
        "platforms": "={{ $json.platforms }}",
        "text": "={{ $json.text }}",
        "mediaUrl": ""
      },
      "id": "sendit_publish_primary",
      "name": "SendIt - Publish Primary",
      "type": "n8n-nodes-sendit.sendIt",
      "typeVersion": 1,
      "position": [920, 100],
      "onError": "continueRegularOutput",
      "credentials": {
        "sendItApi": {
          "id": "",
          "name": "SendIt API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ !!$json.error || $json.success === false }}",
              "value2": true
            }
          ]
        }
      },
      "id": "if_publish_failed",
      "name": "IF Publish Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1160, 100]
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "id": "wait_before_retry",
      "name": "Wait Before Retry",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1400, -20]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    ...$json,\n    retryCount: ($json.retryCount || 0) + 1,\n    text: `${$json.text} (retry attempt)`,\n  },\n}];"
      },
      "id": "increment_retry",
      "name": "Increment Retry Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1640, -20]
    },
    {
      "parameters": {
        "resource": "post",
        "operation": "publish",
        "platforms": "={{ $json.platforms }}",
        "text": "={{ $json.text }}",
        "mediaUrl": ""
      },
      "id": "sendit_publish_retry",
      "name": "SendIt - Publish Retry",
      "type": "n8n-nodes-sendit.sendIt",
      "typeVersion": 1,
      "position": [1880, -20],
      "onError": "continueRegularOutput",
      "credentials": {
        "sendItApi": {
          "id": "",
          "name": "SendIt API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ...$json, scenario: 'retry_idempotency', outcome: 'retry_executed', passed: true } }];"
      },
      "id": "mark_retry_result",
      "name": "Mark Retry Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2120, -20]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ...$json, scenario: 'retry_idempotency', outcome: 'published_primary', passed: true } }];"
      },
      "id": "mark_primary_success",
      "name": "Mark Primary Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 220]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { continueBatch: true } }];"
      },
      "id": "continue_batch",
      "name": "Continue Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2360, 80]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { scenario: 'retry_idempotency', passed: true, status: 'all_items_processed' } }];"
      },
      "id": "batch_complete",
      "name": "Batch Complete",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 260]
    }
  ],
