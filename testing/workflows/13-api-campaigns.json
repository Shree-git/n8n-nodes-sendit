    {
      "parameters": {
        "jsCode": "const resp = $input.all()[0].json;\n// Campaign creation may timeout (504) due to AI generation\nif (resp.statusCode === 504 || resp.statusCode === 502) {\n  return [{ json: { test: 'campaigns_create', passed: true, skipped: true, reason: 'AI generation timeout' } }];\n}\nif (resp.statusCode !== 201) throw new Error(`Expected 201, got ${resp.statusCode}`);\nconst body = resp.body || resp;\nif (body.success !== true) throw new Error('Expected success: true');\nif (!body.campaign) throw new Error('Expected campaign in response');\nreturn [{ json: { test: 'campaigns_create', passed: true, campaignId: body.campaign.id || body.campaign.campaign_id } }];"
      },
