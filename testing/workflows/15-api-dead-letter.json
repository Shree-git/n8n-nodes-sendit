      "id": "list_dead_letter",
      "name": "GET /dead-letter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.all()[0].json;\nif (body.success !== true) throw new Error('Expected success: true');\nif (!Array.isArray(body.posts)) throw new Error('Expected posts array');\nreturn [{ json: { test: 'dead_letter_list', passed: true, hasPosts: body.posts.length > 0, firstPostId: body.posts.length > 0 ? body.posts[0].id : null } }];"
      },
      "id": "assert_list",
      "name": "Assert List OK",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "url": "https://sendit.infiniteappsai.com/api/v1/dead-letter?status=dead&limit=5",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SENDIT_API_KEY}}"
