    {
      "parameters": {
        "jsCode": "const resp = $input.all()[0].json;\nconst status = resp.statusCode || resp.status; if (status !== 404 && status !== 400 && resp.success !== false) throw new Error(`Expected 404/400 or error, got status=${status} success=${resp.success}`);\nreturn [{ json: { test: 'dead_letter_requeue_nonexistent', passed: true } }];"
