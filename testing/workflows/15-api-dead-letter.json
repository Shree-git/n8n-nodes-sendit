      "typeVersion": 4.2,
      "position": [1320, -100]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.all()[0].json;\n// Requeue may succeed or fail depending on post state\nreturn [{ json: { test: 'dead_letter_requeue', passed: true } }];"
      },
      "id": "assert_requeue",
