      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.all()[0].json;\n// Template is returned as CSV text\nconst body = typeof body === 'string' ? body : JSON.stringify(body);\nif (!body || body.length === 0) throw new Error('Expected non-empty CSV template');\nreturn [{ json: { test: 'bulk_template', passed: true, template: body } }];"
      },
      "id": "assert_template",
      "name": "Assert Template OK",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
