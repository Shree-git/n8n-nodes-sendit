{
  "name": "SendIt Test 02 - Publish and Schedule Lifecycle",
  "nodes": [
    {
      "parameters": {},
      "id": "manual_trigger",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst scheduledTime = new Date(now + 2 * 60 * 60 * 1000).toISOString();\nconst runId = `n8n-lifecycle-${now}`;\nreturn [{\n  json: {\n    runId,\n    platforms: ['threads'],\n    publishText: `[${runId}] publish lifecycle smoke`,\n    scheduleText: `[${runId}] scheduled lifecycle smoke`,\n    scheduledTime,\n    platformFilter: 'threads',\n  },\n}];"
      },
      "id": "build_fixture",
      "name": "Build Lifecycle Fixture",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sendit.infiniteappsai.com/api/v1/publish",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{'Bearer ' + $env.SENDIT_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ platforms: $json.platforms, content: { text: $json.publishText } }) }}",
        "options": {}
      },
      "id": "sendit_publish",
      "name": "POST /publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nif (payload.success === false) throw new Error(payload.error || 'Publish failed');\nreturn [{\n  json: {\n    passed: true,\n    scenario: 'publish_now',\n    payloadKeys: Object.keys(payload),\n  },\n}];"
      },
      "id": "assert_publish",
      "name": "Assert Publish",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [780, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sendit.infiniteappsai.com/api/v1/schedule",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{'Bearer ' + $env.SENDIT_API_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ platforms: $node['Build Lifecycle Fixture'].json.platforms, content: { text: $node['Build Lifecycle Fixture'].json.scheduleText }, scheduledTime: $node['Build Lifecycle Fixture'].json.scheduledTime }) }}",
        "options": {}
      },
      "id": "sendit_schedule_create",
      "name": "POST /schedule",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 0]
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nif (payload.success === false) throw new Error(payload.error || 'Schedule create failed');\nconst scheduleId = payload.scheduleId || payload.id || payload.scheduledPost?.id || payload.post?.id || payload.data?.scheduleId || payload.data?.id;\nif (!scheduleId) {\n  throw new Error(`Missing schedule ID in schedule create payload: ${JSON.stringify(payload)}`);\n}\nreturn [{ json: { scenario: 'schedule_create', passed: true, scheduleId } }];"
      },
      "id": "assert_schedule_create",
      "name": "Assert Schedule Create",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 0]
    },
    {
      "parameters": {
        "url": "=https://sendit.infiniteappsai.com/api/v1/scheduled?platform={{ $node['Build Lifecycle Fixture'].json.platformFilter }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{'Bearer ' + $env.SENDIT_API_KEY}}" }
          ]
        },
        "options": {}
      },
      "id": "sendit_schedule_list",
      "name": "GET /scheduled",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 0]
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nif (payload.success === false) throw new Error(payload.error || 'Schedule list failed');\nconst posts = Array.isArray(payload.posts) ? payload.posts : Array.isArray(payload.scheduledPosts) ? payload.scheduledPosts : [];\nreturn [{ json: { scenario: 'schedule_list', passed: true, listedCount: posts.length } }];"
      },
      "id": "assert_schedule_list",
      "name": "Assert Schedule List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1820, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://sendit.infiniteappsai.com/api/v1/scheduled/{{ $node['Assert Schedule Create'].json.scheduleId }}/trigger",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{'Bearer ' + $env.SENDIT_API_KEY}}" }
          ]
        },
        "options": {}
      },
      "id": "sendit_schedule_trigger",
      "name": "POST /scheduled/:id/trigger",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2080, 0]
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nif (payload.success === false) throw new Error(payload.error || 'Schedule trigger failed');\nreturn [{ json: { scenario: 'schedule_trigger', passed: true, payloadKeys: Object.keys(payload) } }];"
      },
      "id": "assert_schedule_trigger",
      "name": "Assert Schedule Trigger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2340, 0]
    }
  ],
  "connections": {
    "Start": { "main": [[{ "node": "Build Lifecycle Fixture", "type": "main", "index": 0 }]] },
    "Build Lifecycle Fixture": {
      "main": [[{ "node": "POST /publish", "type": "main", "index": 0 }]]
    },
    "POST /publish": { "main": [[{ "node": "Assert Publish", "type": "main", "index": 0 }]] },
    "Assert Publish": { "main": [[{ "node": "POST /schedule", "type": "main", "index": 0 }]] },
    "POST /schedule": {
      "main": [[{ "node": "Assert Schedule Create", "type": "main", "index": 0 }]]
    },
    "Assert Schedule Create": {
      "main": [[{ "node": "GET /scheduled", "type": "main", "index": 0 }]]
    },
    "GET /scheduled": {
      "main": [[{ "node": "Assert Schedule List", "type": "main", "index": 0 }]]
    },
    "Assert Schedule List": {
      "main": [[{ "node": "POST /scheduled/:id/trigger", "type": "main", "index": 0 }]]
    },
    "POST /scheduled/:id/trigger": {
      "main": [[{ "node": "Assert Schedule Trigger", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
