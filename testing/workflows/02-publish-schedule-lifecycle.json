          {
            "node": "SendIt - Schedule Create",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SendIt - Schedule Create": {
      "main": [
        [
          {
            "node": "Assert Schedule Create",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Assert Schedule Create": {
      "main": [
        [
          {
            "node": "SendIt - Schedule List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SendIt - Schedule List": {
      "main": [
        [
          {
            "node": "Assert Schedule List",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Assert Schedule List": {
      "main": [
        [
          {
            "node": "SendIt - Schedule Trigger",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SendIt - Schedule Trigger": {
